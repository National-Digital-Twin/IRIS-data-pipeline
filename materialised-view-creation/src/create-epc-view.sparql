PREFIX ies: <http://ies.data.gov.uk/ontology/ies4#>
PREFIX ex: <http://example.org/geo#>
PREFIX data: <http://nationaldigitaltwin.gov.uk/data#>
PREFIX geoplace: <https://www.geoplace.co.uk/addresses-streets/location-data/the-uprn#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Create named graph for EPC mapping
CREATE GRAPH <http://ndtp.co.uk/building-epc-mapping> ;

# Insert building-to-EPC mappings
INSERT { 
    GRAPH <http://ndtp.co.uk/building-epc-mapping> {
        ?building data:hasEPCRating ?epcRating .
        ?uprn_id data:hasEPCRatingUPRN ?epcRating .
    }
}
WHERE {
    # Get EPC ratings using your project's pattern
    ?state ies:isStateOf ?building .
    ?state a ?epc_uri .
    
    # Get UPRN 
    ?building ies:isIdentifiedBy ?uprn .
    ?uprn ies:representationValue ?uprn_id .
    ?uprn rdf:type geoplace:UniquePropertyReferenceNumber .
    
    # Extract the rating
    FILTER(CONTAINS(STR(?epc_uri), "BuildingWithEnergyRatingOf"))
    BIND(STRAFTER(STR(?epc_uri), "BuildingWithEnergyRatingOf") AS ?epcRating)
}
